---
import "../styles/right-sidebar.css";

import packageJson from "../../package.json";
import { siteInfo } from "../data/site";
import { changelog } from "../data/changelog";

const version = packageJson.version;

const latestFeature = changelog[0];
---

<aside class="right-sidebar" aria-label="Site information">
  <section class="changes-block">
    <div class="changes-block__title">
      Site Status
    </div>

    <div>
      <span>Version</span>
      <span>{version}</span>
    </div>

    <div>
      <span>Status</span>
      <span>{siteInfo.status}</span>
    </div>
  </section>

  {latestFeature && (
    <section class="feature-block">
      <div class="feature-block__title">
        Latest Feature
      </div>

      <div class="feature-block__content">
        <span class="feature-version">
          {latestFeature.version}
        </span>

        <h2>{latestFeature.title}</h2>

        <p>
          {latestFeature.description}
        </p>

        <a class="feature-button" href="/changelog">
          View all changes
        </a>
      </div>
    </section>
  )}
</aside>