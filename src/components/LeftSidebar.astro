---
import "../styles/left-sidebar.css";

const cvItems = [
  { label: "Location", value: "Austria" },
  { label: "Role", value: "Software Developer" },
  { label: "Focus", value: "Software / Web / Tools" },
  { label: "Education", value: "Your education here" },
];
---

<aside class="left-sidebar" aria-label="Personal information">
  <header class="left-sidebar__header">
    Profile
  </header>

  <div class="left-sidebar__content">

    <section class="profile-section">
      <figure class="avatar">
        <img
          src="/images/avatar.png"
          alt="Pixel art portrait of me"
          width="160"
          height="160"
        />
      </figure>

      <div class="identity">
        <h2>MaxAlex42</h2>
        <p>
          Software developer and builder of unnecessarily complicated things.
        </p>
      </div>
    </section>

    <section class="sidebar-section">
      <h3>Short CV</h3>

      <dl class="cv-list">
        {cvItems.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="sidebar-section">
      <h3>Current Status</h3>

      <div class="employment-status">
        <span class="status-dot" aria-hidden="true"></span>

        <div>
          <strong>Employed</strong>
          <p>Currently working as a Software Developer.</p>
        </div>
      </div>
    </section>

  </div>
</aside>