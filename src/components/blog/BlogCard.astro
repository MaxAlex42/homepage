---
interface Props {
  title: string;
  abstract: string;
  published: Date;
  tags: string[];
  href: string;

  series?: {
    id: string;
    order: number;
  };
}

const {
  title,
  abstract,
  published,
  tags,
  href,
  series,
} = Astro.props;

const formattedDate =
  new Intl.DateTimeFormat(
    "de-AT",
    {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone: "Europe/Vienna",
    }
  ).format(published);
---

<article
  class="blog-card"
  data-blog-card
  data-title={title.toLowerCase()}
  data-abstract={abstract.toLowerCase()}
  data-tags={tags.join(",").toLowerCase()}
  data-series={series?.id ?? ""}
>
  <header class="blog-card__header">
    <h2>
      <a href={href}>
        {title}
      </a>
    </h2>
  </header>

  <div class="blog-card__content">
    <p>
      {abstract}
    </p>

    {
      tags.length > 0 && (
        <div class="blog-card__tags">
          {
            tags.map((tag) => (
              <span>
                {tag}
              </span>
            ))
          }
        </div>
      )
    }

    <div class="blog-card__footer">
      <span>
        {formattedDate}
      </span>

      {
        series && (
          <a
            class="blog-card__series-tag"
            href={`/blog?series=${encodeURIComponent(series.id)}`}
            title={`View all posts in ${series.id}`}
          >
            Series: {series.id} · Part {series.order}
          </a>
        )
      }
    </div>
  </div>
</article>