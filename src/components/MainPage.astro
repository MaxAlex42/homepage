---
import "../styles/main-page.css";
import { getCollection } from "astro:content";

const techStack = [
  "React",
  "Angular",
  ".NET",
  "Python",
  "C#",
  "Java",
  "C",
  "C++",
];

const projects = (await getCollection(
  "projects",
  ({ data }) => !data.draft && data.featured
))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);
---

<main class="main-page">

  <section class="home-profile">
    <header class="home-profile__header">
      <span class="home-profile__eyebrow">Welcome</span>
      <h1>MaxAlex42</h1>
    </header>

    <div class="home-profile__content">
      <p class="home-profile__lead">
        I'm a fullstack developer interested in building software,
        experimenting and data science.
      </p>

      <section class="home-profile__stack">
        <h2>Tech Stack</h2>

        <div class="tech-stack">
          {techStack.map((technology) => (
            <span>{technology}</span>
          ))}
        </div>
      </section>
    </div>
  </section>


<section class="home-projects">
  <header class="home-projects__header">
    <div>
      <h2>Projects</h2>
    </div>

    <a href="/projects">
      View all
    </a>
  </header>

  <div class="home-projects__list">
    {projects.map((project) => (
      <article class="home-project">
        <header class="home-project__header">
          <div>
            <span class="home-project__status">
              {project.data.status}
            </span>

            <h3>
              <a href={`/projects/${project.id}`}>
                {project.data.title}
              </a>
            </h3>
          </div>

          <span class="home-project__year">
            {project.data.year}
          </span>
        </header>

        <div class="home-project__content">
          <p>
            {project.data.description}
          </p>

          <div class="home-project__footer">
            <div class="home-project__technologies">
              {project.data.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>

            <a
              class="home-project__link"
              href={`/projects/${project.id}`}
            >
              View project
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
</main>