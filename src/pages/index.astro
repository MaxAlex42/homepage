---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThreeColumnLayout from "../layouts/ThreeColumnLayout.astro";

import LeftSidebar from "../components/LeftSidebar.astro";
import MainPage from "../components/MainPage.astro";
import RightSidebar from "../components/RightSidebar.astro";
---

<BaseLayout title="MaxAlex42">
  <ThreeColumnLayout>
    <LeftSidebar slot="left" />

    <MainPage />

    <RightSidebar slot="right" />
  </ThreeColumnLayout>
</BaseLayout>

<script>
  const searchInput =
    document.querySelector<HTMLInputElement>("#project-search");

  const technologyInputs = [
    ...document.querySelectorAll<HTMLInputElement>(
      "[data-project-technology]"
    ),
  ];

  const statusInputs = [
    ...document.querySelectorAll<HTMLInputElement>(
      "[data-project-status]"
    ),
  ];

  const cards = [
    ...document.querySelectorAll<HTMLElement>(
      "[data-project-card]"
    ),
  ];

  const clearButton =
    document.querySelector<HTMLButtonElement>(
      ".project-clear-filters"
    );

  function filterProjects() {
    const query =
      searchInput?.value.trim().toLowerCase() ?? "";

    const selectedTechnologies = technologyInputs
      .filter((input) => input.checked)
      .map((input) => input.value.toLowerCase());

    const selectedStatuses = statusInputs
      .filter((input) => input.checked)
      .map((input) => input.value.toLowerCase());

    for (const card of cards) {
      const title = card.dataset.title ?? "";
      const description = card.dataset.description ?? "";
      const status = card.dataset.status ?? "";

      const technologies = (
        card.dataset.technologies ?? ""
      )
        .split(",")
        .filter(Boolean);

      const matchesSearch =
        !query ||
        title.includes(query) ||
        description.includes(query) ||
        technologies.some((technology) =>
          technology.includes(query)
        );

      const matchesTechnology =
        selectedTechnologies.length === 0 ||
        selectedTechnologies.every((technology) =>
          technologies.includes(technology)
        );

      const matchesStatus =
        selectedStatuses.length === 0 ||
        selectedStatuses.includes(status);

      card.hidden = !(
        matchesSearch &&
        matchesTechnology &&
        matchesStatus
      );
    }
  }

  searchInput?.addEventListener(
    "input",
    filterProjects
  );

  for (const input of technologyInputs) {
    input.addEventListener(
      "change",
      filterProjects
    );
  }

  for (const input of statusInputs) {
    input.addEventListener(
      "change",
      filterProjects
    );
  }

  clearButton?.addEventListener("click", () => {
    if (searchInput) {
      searchInput.value = "";
    }

    for (const input of technologyInputs) {
      input.checked = false;
    }

    for (const input of statusInputs) {
      input.checked = false;
    }

    filterProjects();
  });
</script>